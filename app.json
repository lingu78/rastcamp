{
  "expo": {
    "name": "Rastcamp",
    "slug": "rastcamp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rastcamp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F3F1",
    "ios": {
      "bundleIdentifier": "no.rastcamp.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "no.rastcamp.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#2E6B3F"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rastcamp uses your location to show nearby places and sort them by distance. Your location stays on your phone and is never sent anywhere.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "sv", "nb"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#2E6B3F",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#1F4D2C"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "sv": "./locales/sv.json",
      "nb": "./locales/nb.json",
      "en": "./locales/en.json"
    },
    "icon": "./assets/images/icon.png",
    "extra": {
      "eas": {
        "projectId": "7bd9ea09-5f92-4779-a1cb-3c74b9708fde"
      }
    },
    "owner": "lingu78_app"
  }
}
