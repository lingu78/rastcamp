  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "expo customize tsconfig.json > /dev/null && tsc --noEmit && tsc --noEmit -p data-pipeline",
