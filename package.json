    "test:ci": "jest --ci",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:ci",
    "data:build": "node data-pipeline/src/run.ts",
    "data:update": "node scripts/update-bundled-data.ts",
    "icons:map": "node scripts/generate-map-icons.ts",
    "licenses": "node scripts/generate-licenses.ts",
    "icons:app": "node scripts/generate-app-icons.ts",
    "screenshots:frame": "node scripts/frame-screenshots.ts",
    "store:graphics": "node scripts/generate-feature-graphic.ts"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
